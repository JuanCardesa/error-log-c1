{
  "name": "error-log-c1",
  "version": "2.0.0",
  "private": true,
  "description": "Registro de errores para la preparación del Cambridge C1 Advanced",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanCardesa/error-log-c1.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "demo": "tsx src/lib/db/demo.run.ts",
    "demo:record:build": "tsx src/lib/db/recording.run.ts --build",
    "demo:record": "tsx src/lib/db/recording.run.ts",
    "demo:verify": "playwright test --config playwright.recording.config.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.run.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.run.ts",
    "db:backup": "tsx src/lib/db/backup.run.ts",
    "db:restore": "tsx src/lib/db/restore.run.ts",
    "db:notebook-rebuild": "tsx src/lib/db/notebookSearch.run.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "bench:notebook": "node --expose-gc --import tsx src/lib/db/notebookBench.run.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.33.2"
}
