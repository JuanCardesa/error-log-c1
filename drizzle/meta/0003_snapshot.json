      "checkConstraints": {
        "session_items_non_negative": {
          "name": "session_items_non_negative",
          "value": "\n      (\"session\".\"items_total\" IS NULL OR \"session\".\"items_total\" >= 0)\n      AND (\"session\".\"items_correct\" IS NULL OR \"session\".\"items_correct\" >= 0)\n    "
        },
        "session_items_correct_le_total": {
          "name": "session_items_correct_le_total",
          "value": "\n      \"session\".\"items_correct\" IS NULL\n      OR \"session\".\"items_total\" IS NULL\n      OR \"session\".\"items_correct\" <= \"session\".\"items_total\"\n    "
        },
        "session_items_required_outside_writing": {
          "name": "session_items_required_outside_writing",
          "value": "\n      \"session\".\"paper\" IS 'WRITING'\n      OR (\"session\".\"items_total\" IS NOT NULL AND \"session\".\"items_correct\" IS NOT NULL)\n    "
        },
        "session_part_within_paper": {
          "name": "session_part_within_paper",
          "value": "\n      (\"session\".\"paper\" IS NULL AND \"session\".\"part\" IS NULL)\n      OR (\n        \"session\".\"paper\" IS NOT NULL AND \"session\".\"part\" IS NOT NULL\n        AND typeof(\"session\".\"part\") = 'integer'\n        AND \"session\".\"part\" >= 1 AND \"session\".\"part\" <= CASE \"session\".\"paper\"\n          WHEN 'RUOE' THEN 8\n          WHEN 'WRITING' THEN 2\n          WHEN 'LISTENING' THEN 4\n          WHEN 'SPEAKING' THEN 4\n          ELSE 0\n        END\n      )\n    "
        },
        "session_writing_kind_implies_writing_paper": {
          "name": "session_writing_kind_implies_writing_paper",
          "value": "\n      \"session\".\"kind\" <> 'WRITING' OR \"session\".\"paper\" IS 'WRITING'\n    "
        }
      }
